PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (MySQL)
DATABASE_URL=mysql://user:password@host:3306/database_name
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=banpong_molly
# Optional: bootstrap reconnect when DB is not ready yet
# DATABASE_RETRY_ATTEMPTS=20
# DATABASE_RETRY_DELAY_MS=3000
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_MS=10000

# Mail (e.g. Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# Redis / BullMQ (shared queue: mail, checkout ฯลฯ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# prefix คีย์ใน Redis เช่น banpong-molly:mail-content-send:...
REDIS_PREFIX=banpong-molly

# จำนวนออเดอร์สูงสุดต่อรันของสคริปต์กวาดส่งใบเสร็จ (สูงสุด 5000 ต่อรอบตามเพดานในโค้ด)
RECEIPT_EMAIL_BATCH_LIMIT=5000

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRATION=7d
JWT_RESET_SECRET=your-reset-secret
JWT_RESET_EXPIRATION=1h

# Google OAuth (สำหรับ Login ด้วย Google - ใช้ Client ID จาก Google Cloud Console)
# ใช้แค่ GOOGLE_CLIENT_ID ก็เพียงพอ (สำหรับตรวจ id_token จากฝั่ง client)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
